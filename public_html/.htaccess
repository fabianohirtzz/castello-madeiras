# Castello Casas de Madeira. Producao (EreHost): LiteSpeed, que le .htaccess
# com a sintaxe do Apache 2.4.

AddDefaultCharset UTF-8
DirectoryIndex index.php index.html
Options -Indexes

# HTTPS obrigatorio. Inegociavel: o painel manda senha por este canal.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # O endereco oficial e sem www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Enderecos do site antigo (WordPress) que o Google conhece: catalogo e PDFs.
  RewriteRule ^catalogo(/.*)?$ /casa-pronta [R=301,L,NC]
  RewriteRule ^wp-content/uploads/.*\.pdf$ /casa-pronta [R=301,L,NC]

  # /llms.txt: resumo do negocio para as ferramentas de IA, gerado do banco.
  RewriteRule ^llms\.txt$ llms.php [L]

  # /index.php e a home: um endereco so para o Google.
  RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
  RewriteRule ^index\.php$ / [R=301,L,NC]

  # Redireciona requisicoes diretas com .php para a versao limpa
  RewriteCond %{THE_REQUEST} \s/+(casa-pronta|flex|portfolio|depoimentos|contato|politica-de-privacidade|link)\.php[\s?] [NC]
  RewriteRule ^(casa-pronta|flex|portfolio|depoimentos|contato|politica-de-privacidade|link)\.php$ /%1 [R=301,L,NC]

  # Normaliza URLs com barra no fim (os caminhos da pagina sao relativos a raiz)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(casa-pronta|flex|portfolio|depoimentos|contato|politica-de-privacidade|link)/$ /$1 [R=301,L,NC]

  # URLs limpas: serve o arquivo .php correspondente
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-zA-Z0-9_-]+)$ $1.php [L,QSA]
</IfModule>

# Cabecalhos de seguranca. HSTS sem includeSubDomains: so este endereco.
# SAMEORIGIN: nenhum outro site pode abrir estas paginas dentro de um iframe.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Nada de servir banco, schema, segredo ou arquivo de ambiente.
<FilesMatch "(^\.|\.(sql|db|db-wal|db-shm|sqlite|log|ini|bak|old|sh)$|^caminho-config\.php$)">
  Require all denied
</FilesMatch>

# Os dois arquivos de lib/ que nunca podem ser lidos pelo navegador,
# nomeados por extenso para nao depender da expressao acima.
<Files "schema.sql">
  Require all denied
</Files>
<Files "caminho-config.php">
  Require all denied
</Files>
<Files "castello.db">
  Require all denied
</Files>

# Compressao e cache dos estaticos. As paginas PHP mandam o proprio
# Cache-Control, porque carregam o token do formulario.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
